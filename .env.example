# Copy to .env and fill values. Never commit .env
#   cp .env.example .env

# 所有 WebUI 可编辑配置都使用 .env 覆盖 config/*.py 默认值。

# ---- WebUI 授权 ----
# WebUI 登录授权码；仅保存在 .env，避免出现在进程命令行中
WEBUI_AUTH_CODE=
# 可选：Session Cookie 签名密钥；留空时从固定授权码派生，修改授权码会使已有登录失效
WEBUI_SESSION_SECRET=


# ---- 功能开关 ----
# 启用 Codex OAuth: 注册成功后自动跑 Codex 授权（全新session+接码），落盘 codex-邮箱.json
ENABLE_CODEX_AUTO=

# ---- 注册方式 ----
# 注册驱动: protocol=纯协议(curl_cffi，默认)；roxy=RoxyBrowser；cloak=CloakBrowser；
#           browser_use=Browser Use Cloud+Playwright；skyvern=Skyvern Browser Sessions
# 浏览器指纹被风控时切回 protocol（纯HTTP），可用 tools/check_protocol_chain.py 先体检链路
REGISTRATION_DRIVER=

# ---- CloakBrowser ----
# Cloak无头: True=无头运行；False=显示浏览器窗口
CLOAK_HEADLESS=
# Cloak人工行为: 启用 CloakBrowser humanize 鼠标/键盘/滚动行为
CLOAK_HUMANIZE=
# Cloak按出口定位: 按当前出口 IP 自动匹配时区/语言/WebRTC IP；支持显式代理、系统代理/VPN
CLOAK_GEOIP=
# Cloak语言: 留空自动；日本可填 ja-JP，美国 en-US
CLOAK_LOCALE=
# Cloak时区: 留空自动；日本可填 Asia/Tokyo，美国 America/Los_Angeles
CLOAK_TIMEZONE=
# Cloak使用代理: 把本项目传入或代理池抽取的代理传给 CloakBrowser
CLOAK_USE_PROXY=
# Cloak License: Pro license；留空使用免费 binary
CLOAK_LICENSE_KEY=
# Cloak指纹Seed: 留空每次随机；固定值可保持同一指纹
CLOAK_FINGERPRINT_SEED=
# Cloak用户目录: 留空使用临时上下文；填写路径则持久化 cookies/cache
CLOAK_USER_DATA_DIR=
# Cloak超时: 页面和元素等待超时时间，秒
CLOAK_SELENIUM_TIMEOUT=
# 保留Cloak浏览器: 调试时开启，任务结束后不自动关闭
CLOAK_KEEP_BROWSER_OPEN=

# ---- Browser Use ----
# Browser Use API Key: 保存在 .env（BROWSER_USE_API_KEY），不写回 config/*.py
BROWSER_USE_API_KEY=
# 代理国家代码: 两位国家码，如 jp/us/sg；配合 Browser Use 内置 residential proxy
BROWSER_USE_PROXY_COUNTRY_CODE=
# 使用内置代理: True=连接参数带 proxyCountryCode；False=不强制传国家代理参数
BROWSER_USE_USE_PROXY=
# Profile ID: 可选。填写则复用 Browser Use profile 的 cookies/localStorage；批量建议留空
BROWSER_USE_PROFILE_ID=
# CDP 地址: 默认 wss://connect.browser-use.com
BROWSER_USE_CDP_BASE=
# 操作超时(秒): Playwright 默认操作超时
BROWSER_USE_TIMEOUT=
# 快速模式: 减少 Browser Use 额外等待和 humanize 延迟；建议开启，异常排查时可关闭
BROWSER_USE_FAST_MODE=
# 耗时日志: 打印 Browser Use 各阶段耗时：连接、打开页面、邮箱、OTP、手机、callback
BROWSER_USE_LOG_TIMING=
# 保留远端会话: 调试时可不主动 browser.close()；默认 False
BROWSER_USE_KEEP_BROWSER_OPEN=
# 起始 URL: 默认 https://chatgpt.com/auth/login
BROWSER_USE_START_URL=

# ---- Skyvern ----
# Skyvern API Key：用于创建 Browser Session
SKYVERN_API_KEY=
# API 地址：默认 https://api.skyvern.com
SKYVERN_API_BASE=
# Browser Session 超时（分钟）
SKYVERN_BROWSER_SESSION_TIMEOUT=
# 可选：复用 Skyvern browser profile
SKYVERN_BROWSER_PROFILE_ID=
# 可选：Skyvern 代理地区；jp 会自动转 RESIDENTIAL_JP
SKYVERN_PROXY_LOCATION=
# 浏览器类型：默认 stealth-chromium；可选 msedge/chrome/stealth-chromium
SKYVERN_BROWSER_TYPE=
# 是否启用广告拦截
SKYVERN_AD_BLOCKER=
# 结束时是否保存 browser profile
SKYVERN_GENERATE_BROWSER_PROFILE=
# 调试时保留浏览器
SKYVERN_KEEP_BROWSER_OPEN=
# 起始 URL
SKYVERN_START_URL=

# ---- RoxyBrowser ----
# Roxy API 地址: 默认 http://127.0.0.1:50000；需在 Roxy 应用 API 配置中开启
ROXY_API_BASE=
# Roxy API Key: 保存在 .env（ROXY_API_TOKEN），不写回 config/*.py
ROXY_API_TOKEN=
# Roxy 环境ID: 指定要打开的 Roxy 浏览器环境/Profile ID；留空则尝试创建临时环境
ROXY_PROFILE_ID=
# Roxy 工作区ID: 创建一号一环境时必填，会作为 workspaceId 提交给 Roxy 创建 Profile 接口
ROXY_WORKSPACE_ID=
# Roxy 项目ID: 从 /browser/workspace 的 project_details.projectId 获取；创建 Profile 时会作为 projectId 提交
ROXY_PROJECT_ID=
# 获取团队接口: 默认 /browser/workspace；点击获取团队/项目时会先试此路径，再自动尝试常见兼容路径
ROXY_WORKSPACE_LIST_PATH=
# 打开接口路径: 默认 /browser/open；如 Roxy 版本不同可在此调整
ROXY_OPEN_PATH=
# 无头启动窗口: 打开 Roxy 环境时向 /browser/open 传 headless；False=显示窗口，True=无头启动
ROXY_OPEN_HEADLESS=
# 关闭接口路径: 默认 /browser/close
ROXY_CLOSE_PATH=
# 保留浏览器: 调试时可开启，任务结束后不自动关闭 Roxy 环境
ROXY_KEEP_BROWSER_OPEN=
# 一号一环境: 每个账号强制创建新 Roxy Profile，用完关闭并删除，禁止复用固定环境
ROXY_ONE_PROFILE_PER_ACCOUNT=
# 结束后删除环境: 一号一环境模式下，任务结束后删除本轮创建的 Roxy Profile
ROXY_DELETE_PROFILE_AFTER_RUN=
# 创建环境使用代理池: 创建 Roxy 环境时从配置页「代理池」随机取一个代理，写入 Roxy proxyInfo
ROXY_CREATE_USE_PROXY_POOL=
# 代理检测通道: 写入 Roxy proxyInfo.checkChannel；留空则不传，默认 IPRust.io
ROXY_PROXY_CHECK_CHANNEL=
# 删除接口路径: 默认 /browser/delete；如 Roxy 版本不同可调整
ROXY_DELETE_PATH=

# ---- CPA / Codex ----
# Codex授权驱动: protocol=原协议授权；roxy=用 RoxyBrowser；cloak=用 CloakBrowser；browser_use=用 Browser Use Cloud；skyvern=用 Skyvern；same_as_registration=跟随注册驱动
CODEX_OAUTH_DRIVER=

# ---- RoxyBrowser ----
# Codex回调超时: Roxy Codex OAuth 等待 localhost:1455 callback 的最长秒数
ROXY_CODEX_CALLBACK_TIMEOUT=

# ---- 功能开关 ----
# 启用 2FA(TOTP): 注册完成后自动设置动态口令（会多收一封 OTP 邮件）
ENABLE_2FA=
# 启用 Flow 触发: 注册成功后自动调用内部 Flow 接口（不影响注册结果）
ENABLE_FLOW_TRIGGER=

# ---- 人工节奏 ----
# 启用随机停顿: 在注册、OTP、授权等步骤之间加入随机等待，更接近人工操作节奏
ENABLE_HUMANIZE_DELAY=
# 停顿倍率: 随机停顿整体倍率；1.0=默认，0.5=减半，2.0=加倍
HUMANIZE_DELAY_FACTOR=

# ---- 邮箱 / OTP ----
# 自动取邮箱+收码: True=从邮箱池自动领邮箱并自动收 OTP；False=手动模式：用 REGISTER_EMAIL，OTP 在任务页手填
USE_EMAIL_SERVICE=
# 手动注册邮箱: USE_EMAIL_SERVICE=False 时必填。例如你的 outlook.com 地址；OTP 去网页邮箱看，再回任务页提交
REGISTER_EMAIL=
# 显示名称: 留空则自动生成英文名
REGISTER_NAME=
# OTP 最长等待(秒): 等待验证码邮件的最长秒数，超时判失败
OTP_MAX_WAIT=
# OTP 轮询间隔(秒): 每隔多少秒查一次新邮件
OTP_POLL_INTERVAL=
# 邮箱来源: 可填单个或多个，逗号分隔并按顺序兜底：outlook,generic_api,cloudflare_domain,cloudflare,gptmail,mailnest,cloudmail
EMAIL_SOURCE=
# Outlook取件模式: auto=远端优先，远端 402/DEPLOYMENT_DISABLED 自动切 Graph 直连；direct=只用 Microsoft Graph 直连；remote=只用远端服务
OUTLOOK_FETCH_MODE=
# 仅 cloudflare_domain：Email Routing 转发域名，如 mydomain.com（与 EMAIL_SOURCE=cloudflare 无关）
EMAIL_DOMAIN=
# 仅 cloudflare_domain：接收 Email Routing 转发的 QQ 邮箱，如 123456@qq.com
QQ_EMAIL=
# 仅 cloudflare_domain：QQ 邮箱 IMAP 授权码（不写回 config/*.py）
QQ_IMAP_PASSWORD=
# GPTMail API Key: 选择 EMAIL_SOURCE=gptmail 时必填；服务地址固定为 https://mail.chatgpt.org.uk
GPTMAIL_API_KEY=

# Cloudflare Worker 临时邮箱（EMAIL_SOURCE 含 cloudflare 时；与 cloudflare_domain/QQ IMAP 不同）
# Worker API 根地址，例如 https://mail.example.com（不要末尾多余路径）
CLOUDFLARE_API_BASE=
# 匿名可空；admin 模式填 ADMIN_PASSWORD
CLOUDFLARE_API_KEY=
# none / bearer / x-api-key / x-admin-auth / query-key；admin 推荐 x-admin-auth
CLOUDFLARE_AUTH_MODE=
# Worker 全局密码，注入请求头 x-custom-auth；无则留空
CLOUDFLARE_CUSTOM_AUTH=
# 创建邮箱路径: 默认 /api/new_address；admin 创建常用 /admin/new_address
CLOUDFLARE_PATH_ACCOUNTS=
# 邮件列表路径: 默认 /api/mails
CLOUDFLARE_PATH_MESSAGES=
# 域名列表路径: 默认 /api/domains
CLOUDFLARE_PATH_DOMAINS=
# Token 路径: 默认 /api/token（fallback 预留）
CLOUDFLARE_PATH_TOKEN=
# 默认收信域名，逗号分隔，例如 mail.example.com；可留空由 Worker 决定
CLOUDFLARE_DEFAULT_DOMAINS=
# HTTP 请求超时秒数，默认 20
CLOUDFLARE_REQUEST_TIMEOUT=
# admin 创建时随机 local-part 长度，默认 10
CLOUDFLARE_NAME_LENGTH=
# MailNest-迈巢 Outlook 临时邮箱的 api key 获取页面 https://mailnest.top/account
MAIL_NEST_API_KEY=
# MailNest 项目代码：默认 chatgpt001
MAIL_NEST_PROJECT_CODE=
# CloudMail/Cloud Mail API 地址，例如 https://mail.example.com
CLOUDMAIL_API_BASE=
# CloudMail 管理员邮箱；填写账号密码后保存配置会自动获取 CLOUDMAIL_AUTH_TOKEN
CLOUDMAIL_ADMIN_EMAIL=
# CloudMail 登录密码
CLOUDMAIL_PASSWORD=
# CloudMail 生成 Token 接口路径，默认 /api/public/genToken
CLOUDMAIL_TOKEN_PATH=
# CloudMail/Cloud Mail API Authorization Token
CLOUDMAIL_AUTH_TOKEN=
# CloudMail 邮箱域名列表，每行一个
CLOUDMAIL_DOMAINS=
# 生成随机邮箱后是否自动调用 /api/public/addUser
CLOUDMAIL_AUTO_ADD_USER=
# 随机邮箱 local-part 长度
CLOUDMAIL_RANDOM_LOCAL_LENGTH=

# ---- 浏览器画像 ----
# 地区画像: 应与代理出口地区一致；可选 jp/cn/us/sg。当前本地代理实测为日本东京，推荐 jp
BROWSER_LOCALE_PROFILE=
# 按出口IP自动画像: 开启后每个 BrowserSession 会用当前代理出口 IP 自动选择语言/时区；失败时回退到地区画像
AUTO_BROWSER_LOCALE_FROM_IP=
# IP定位超时(秒): 出口 IP 地理信息接口的单次请求超时；接口失败会自动回退，不影响注册
IP_GEO_TIMEOUT=

# ---- 代理池 ----
# 代理池(每行一个): 每行一个代理 URL，留空行会被忽略；为空则不使用代理
PROXY_POOL=
# 套餐查询网络模式: auto=本地代理可用则使用、未监听则直连；proxy=强制代理；direct=强制直连
PLAN_CHECK_PROXY_MODE=
# 套餐查询专用代理: 留空时 auto/proxy 从代理池选择；可能包含认证信息
PLAN_CHECK_PROXY=

# ---- CPA / Codex ----
# 授权地址来源: cpa=由 CPA 管理接口生成授权地址；local=旧版本地生成 PKCE 授权地址
CODEX_AUTH_URL_SOURCE=
# CPA 管理地址: 例如 http://localhost:8317/admin/oauth；程序会取 origin 调用 /v0/management/*
CPA_MANAGEMENT_URL=
# 管理密钥: 保存在 .env（CPA_MANAGEMENT_KEY），不写回 config/*.py
CPA_MANAGEMENT_KEY=
# CPA 超时(秒): 请求 CPA 管理接口的超时时间
CPA_REQUEST_TIMEOUT=
# 保存CPA回执: CPA 未返回完整授权文件时，本地仍保存一份回调提交记录
CPA_SAVE_CALLBACK_RECEIPT=

# ---- 接码平台 ----
# 接码通道: grizzly / l / h；h 使用 H_API.md 定义的本地取号服务
SMS_PROVIDER=
# 国家代码: 传给接码平台的 country；GrizzlySMS 常用：美国=187；L/H 通道按本地后台配置填写
SMS_COUNTRY=
# 服务/项目代码: GrizzlySMS/L 作为 service；H 通道可复用为 projectId
# 注意：OpenAI/ChatGPT 的 GrizzlySMS 服务码是 dr（API 名称 "AI Chat"），不是 openai
SMS_SERVICE=
# 换号重试次数: 一个号收不到短信/被OpenAI拒时换下一个号，最多重试几次
SMS_MAX_RETRIES=
# 单号等短信(秒): 单个号等待短信到达的最长秒数，超时则换号
SMS_CODE_WAIT=
# GrizzlySMS API密钥: 保存在 .env（SMS_API_KEY），不写回 config/*.py
SMS_API_KEY=
# H API 地址: H 取号服务基础地址，例如 http://localhost:8788
H_API_BASE=
# H 授权码: 保存在 .env（H_ADMIN_AUTH_CODE），不写回 config/*.py
H_ADMIN_AUTH_CODE=
# H 号码前缀: H 返回号码不含国家码时填写，例如美国 10 位本地号填 1；留空则不补
H_PHONE_PREFIX=
# H 取号方式: reusable=优先复用号码；new=每次取新号（调用 /api/admin/h/take-phone）
H_PHONE_ACQUIRE_MODE=
# L API 地址: L 取号服务基础地址，例如 http://localhost:8788
L_API_BASE=
# L 授权码: 保存在 .env（L_ADMIN_AUTH_CODE），不写回 config/*.py
L_ADMIN_AUTH_CODE=
# L 号码前缀: L 返回号码不含国家码时填写，例如美国 10 位本地号填 1；留空则不补
L_PHONE_PREFIX=

# ManyMail 自建邮箱（DuckMail 兼容）。建议 EMAIL_SOURCE 末尾追加 manymail 作保底
MANYMAIL_API_BASE=
MANYMAIL_DOMAINS=
MANYMAIL_RANDOM_LOCAL_LENGTH=


# ---- CPA Manager Plus（18317）认证文件即时导入 ----
# 与上面 cli-proxy-api(8317) 的 CPA_MANAGEMENT_KEY 不是同一个 key：
# 在 docker logs cpa-manager-plus 首启日志里找 cpamp_... 管理密钥
CPA_MANAGER_PLUS_BASE=http://127.0.0.1:18317
CPA_MANAGER_PLUS_KEY=
# 注册成功后是否立即导入 CPA Manager Plus（token 寿命短，默认开）
AUTO_IMPORT_TO_CPA_MANAGER=true

# ---- Sentinel SDK 版本自动发现（core.sentinel_sdk）----
# 开启后每次注册前探测 chatgpt.com 当前 sdk.js 版本并按版本缓存到 sentinel/，
# OpenAI 升级 SDK 后自动换新，避免写死版本失效；False 则始终用 SENTINEL_SV + 项目自带 sdk.js
SENTINEL_SDK_AUTO_UPDATE=true
# 探测结果内存缓存时长（秒），默认 3600
SENTINEL_SDK_TTL_SECONDS=
# Sentinel /req 入口域名，默认 https://sentinel.openai.com；可切换 https://chatgpt.com
SENTINEL_REQ_ORIGIN=
# 手动固定 sdk.js 版本（自动发现失败/关闭时使用）
SENTINEL_SV=

# ---- 协议注册密码分支（A/B 分流到 create-account/password 时走 user/register）----
# True：自动提交用户名+密码完成创建再收 OTP（参考 sleep-reg gpt_register.py）；False：遇密码页直接报错
PROTOCOL_PASSWORD_BRANCH_ENABLED=true
# 密码分支使用的注册密码；留空则自动生成 14+ 位强密码（见 core.profile_utils.registration_password）
REGISTER_PASSWORD=

# ---- 1ip1号 IP 纪律（core.ip_discipline，论坛经验：同 IP 多号连坐死）----
# 开启后注册管线强制一个出口 IP 一个号：树脂动态会话天然唯一，静态代理按 host:port 去重
IP_DISCIPLINE_ENABLED=true
# 同一 IP 使用后的冷却窗口（秒），冷却期内不再分配给新账号，默认 1800（30 分钟）
IP_COOLDOWN_SECONDS=
# 同一 IP 最多注册账号数，1 = 严格 1ip1号
MAX_ACCOUNTS_PER_IP=
# 注册任务等待可用 IP 的最长秒数（池冷却/占满时自节流），超时任务失败，默认 600
IP_DISCIPLINE_MAX_WAIT_SECONDS=

# ---- GCash 渠道（真实菲律宾钱包支付 Plus）+ HeroSMS 接码 ----
# 社区渠道：OpenAI 结算切菲律宾 → Stripe Checkout QR → GCash App 扫码付款。
# 全程手机端不要挂梯子；菲律宾号接码只有 HeroSMS 稳定（10分钟2码/IP，批量轮换出口 IP）。
# API 文档: https://hero-sms.com/cn/api （sms-activate 兼容协议）
ENABLE_GCASH_PLUS=false
# checkout=输出结算 URL/二维码；full=checkout+轮询支付结果+自动验证 Plus
GCASH_PLUS_MODE=checkout
GCASH_PLUS_PAYMENT_TIMEOUT=900
GCASH_PLUS_POLL_INTERVAL=15
GCASH_PLUS_QR_PORT=8787

# HeroSMS 接码（GCash 注册必填）
HERO_SMS_API_KEY=
HERO_SMS_BASE_URL=https://hero-sms.com/stubs/handler_api.php
# 批量轮换出口 IP 时留空，用 GCASH_REGISTER_ROTATE_PROXY=true 自动从 PROXY_POOL 抽
HERO_SMS_PROXY=
HERO_SMS_SERVICE=gcash
HERO_SMS_COUNTRY=6
HERO_SMS_MAX_PRICE=
HERO_SMS_WAIT_TIMEOUT=240
HERO_SMS_POLL_INTERVAL=5

# ChatGPT 号注册成功后自动跑 GCash 号注册（HeroSMS 买菲号+接码+ADB 驱动 GCash App）
ENABLE_GCASH_REGISTER=false
GCASH_REGISTER_ROTATE_PROXY=true
# ADB 设备串号（adb devices 查看）；留空则只打印接码步骤不操作设备
GCASH_ADB_SERIAL=
GCASH_APP_PACKAGE=com.globe.gcash.android
# 菲律宾注册信息 JSON 文件路径或内联对象（姓名/生日/邮箱）
GCASH_REGISTER_PROFILE=

# ---- 解码保号（AT→refresh_token，默认关）----
# 注册成功后自动跑 phone_verify_refresh：AT → GrizzlySMS 接码(服务码 dr) →
# Codex OAuth → refresh_token + CPA 兼容凭证 codex_accounts/codex-{email}.json。
# 默认 false：不调用、不产生接码费用；只有你明确说「解码保号」时才置 true。
REFRESH_DECODE_ENABLED=false
